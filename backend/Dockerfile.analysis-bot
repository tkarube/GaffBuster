FROM node:22-slim

# Install dependencies for downloading and running Stockfish
RUN apt-get update && apt-get install -y \
    wget \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Download and install Stockfish 18 (BMI2 binary)
RUN wget https://github.com/official-stockfish/Stockfish/releases/download/sf_18/stockfish-ubuntu-x86-64-bmi2.tar -O stockfish.tar \
    && tar -xf stockfish.tar \
    && mv stockfish/stockfish-ubuntu-x86-64-bmi2 /usr/local/bin/stockfish \
    && chmod +x /usr/local/bin/stockfish \
    && rm -rf stockfish.tar stockfish

WORKDIR /app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm install

# Copy the analysis bot code and common files
COPY analysis-bot.js .
COPY config.json.example .

# Ensure analyzed_games.json exists (as a placeholder, will be mounted)
RUN echo "[]" > analyzed_games.json
RUN mkdir results

# Start the analysis bot
CMD ["node", "analysis-bot.js"]
